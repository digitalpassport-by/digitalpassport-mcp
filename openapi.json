{
  "openapi": "3.1.0",
  "info": {
    "title": "Цифровой паспорт компании API (digitalpassport.by)",
    "version": "1.2.0",
    "description": "Публичный API в режиме чтения для получения проверяемых цифровых паспортов белорусских организаций и навигации по графу знаний. Лимит частоты: 45 запросов в минуту без ключа (максимум 25 карточек на страницу) и 300 запросов в минуту с бесплатным ключом dpk_ верифицированной компании."
  },
  "servers": [
    {
      "url": "https://digitalpassport.by"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Бесплатный ключ вида dpk_... из личного кабинета верифицированной компании (повышает лимит до 300 запросов в минуту)."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Альтернативная передача ключа dpk_... в заголовке Authorization: Bearer."
      }
    },
    "schemas": {
      "RateLimitError": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string",
            "const": "rate_limit_exceeded"
          },
          "message": {
            "type": "string"
          },
          "docs_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "ok",
          "error",
          "message"
        ]
      }
    }
  },
  "paths": {
    "/api/v1/knowledge-graph": {
      "get": {
        "operationId": "exploreKnowledgeGraph",
        "summary": "Получить двухуровневую онтологию специализаций графа знаний",
        "parameters": [
          {
            "name": "family",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Слаг широкого направления для фильтрации дочерних специализаций"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Поиск по названию или слагу специализации"
          }
        ],
        "responses": {
          "200": {
            "description": "Структура семейств и канонических специализаций графа знаний"
          },
          "429": {
            "description": "Превышен лимит частоты запросов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies": {
      "get": {
        "operationId": "searchBelarusCompanies",
        "summary": "Поиск компаний по названию, УНП, городу, рубрике или специализации",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Поисковый запрос: название компании, бренд, услуга или 9 цифр УНП"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Фильтр по названию или слагу города"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Слаг отраслевой рубрики"
          },
          {
            "name": "specialization",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Слаг или название специализации из графа знаний"
          },
          {
            "name": "verified",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Только организации со статусом «Верифицировано»"
          },
          {
            "name": "has_site",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Только организации с подтверждённым официальным сайтом"
          },
          {
            "name": "min_years",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                5,
                10
              ]
            },
            "description": "Минимальный возраст компании на рынке в годах (5 или 10)"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "default": 20
            },
            "description": "Количество карточек в ответе (от 1 до 25)"
          }
        ],
        "responses": {
          "200": {
            "description": "Список найденных паспортов компаний"
          },
          "429": {
            "description": "Превышен лимит частоты запросов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{identifier}": {
      "get": {
        "operationId": "getCompanyPassport",
        "summary": "Получить полный цифровой паспорт компании по 9-значному УНП или слагу",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "9 цифр УНП или постоянный слаг карточки компании"
          }
        ],
        "responses": {
          "200": {
            "description": "Полный структурированный цифровой паспорт со ссылками на первоисточники и графом Schema.org"
          },
          "404": {
            "description": "Организация не найдена"
          },
          "429": {
            "description": "Превышен лимит частоты запросов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitError"
                }
              }
            }
          }
        }
      }
    }
  }
}
